# AI Commerce Platform Environment Variables

# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=true

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME="AI Commerce Platform"
HOST=0.0.0.0
PORT=8000

# CORS & Frontend Origins (comma-separated)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Database Configuration (PostgreSQL)
# Admin connection string (used for migrations and DDL)
MIGRATION_DATABASE_URL=postgresql+asyncpg://commerce_admin:commerce_admin_secret@localhost:5433/commerce_db
# Non-superuser connection string (used at runtime so RLS is strictly enforced)
DATABASE_URL=postgresql+asyncpg://commerce_app:commerce_app_secret@localhost:5433/commerce_db
# Test database connection string
TEST_DATABASE_URL=postgresql+asyncpg://commerce_app:commerce_app_secret@localhost:5433/commerce_test_db

# JWT & Security
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Storage (local or azure)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=media

# Logging
LOG_LEVEL=INFO
